# Copy this file to `.env` and update values for local development.
# Do NOT commit real credentials into the repo. Use environment variables or
# a secret manager in CI/CD. Example usage:
#   $env:GOOGLE_APPLICATION_CREDENTIALS='C:\path\to\service-account.json'

# Path to Google service account JSON (optional for local server features)
GOOGLE_APPLICATION_CREDENTIALS=./path/to/tiaras-website-firebase-adminsdk-<id>.json

# When set to 1, the local dev server will allow legacy inline scripts
# (adds 'unsafe-inline' to script-src in the CSP). Use only for short-term
# compatibility while refactoring away inline handlers.
DEV_ALLOW_UNSAFE_INLINE=0
