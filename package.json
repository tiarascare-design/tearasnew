{
  "name": "tearas-bundle-build",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:js": "node build.js",
    "build:css": "tailwindcss -i assets/css/tailwind.input.css -o assets/css/styles.css --minify",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "tailwindcss": "^3.4.0"
  }
}
{
  "name": "tiaras-web",
  "version": "0.0.0",
  "private": true,
  "description": "Tiaras Web local project - minimal package.json added to enable tooling checks",
  "scripts": {
    "test": "npx playwright test",
    "test:unit": "vitest",
    "lint": "echo 'No linter configured'"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "jsdom": "^27.1.0",
    "vitest": "^1.1.5"
  },
  "vitest": {
    "test": {
      "environment": "jsdom"
    }
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "axios": "^1.13.2",
    "firebase-admin": "^13.6.0",
    "puppeteer": "^24.30.0"
  }
}
