{
  "name": "tiaras-web",
  "version": "0.0.0",
  "private": true,
  "description": "Tiaras Web local project - minimal package.json added to enable tooling checks",
  "scripts": {
    "test": "npx playwright test",
    "test:unit": "vitest",
    "lint": "echo 'No linter configured'",
    "security:audit": "node ../scripts/security_audit.js",
    "build:css": "npx tailwindcss -i src/styles/tailwind.input.css -o assets/css/tailwind.css --minify"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "tailwindcss": "^3.5.4",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "jsdom": "^27.1.0",
    "vitest": "^1.1.5"
  },
  "vitest": {
    "test": {
      "environment": "jsdom"
    }
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "axios": "^1.13.2",
    "firebase-admin": "^13.6.0",
    "puppeteer": "^24.30.0"
  }
}
